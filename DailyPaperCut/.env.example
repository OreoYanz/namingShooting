OPENAI_API_KEY=your_openai_api_key_here
# optional override
# OPENAI_BASE_URL=https://api.openai.com/v1

# 產生當日包完成後是否自動寫入官網並 git push（預設 true）
# AUTO_PUBLISH_SITE=false

# 產生完成後是否自動上傳 YouTube Shorts（預設 true；無 token 會略過）
# AUTO_PUBLISH_YOUTUBE=false
# YOUTUBE_PRIVACY=private
# # public / unlisted / private（預設 private＝不公開）
# 詳見 docs/YOUTUBE_SETUP.md

# 官網公開網址（Cloudflare Worker；社群媒體／CTA 會用到）
PUBLIC_MEDIA_BASE_URL=https://mingxu.mingxu.workers.dev

# --- 產生完成後寄社群文案＋MP4 到 Gmail ---
# 必須用「應用程式密碼」，不能填一般登入密碼
# 1) Google 帳號開啟兩步驟驗證
# 2) https://myaccount.google.com/apppasswords 建立應用程式密碼
# 3) 把 16 碼貼到 GMAIL_APP_PASSWORD（有空白也可）
GMAIL_USER=nameshootingmingxu@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_TO=nameshootingmingxu@gmail.com
# GMAIL_SMTP_PORT=465
# GMAIL_FROM=
# GMAIL_DISABLE=true

# --- Meta 社群發文（詳見 docs/META_SETUP.md；手動發文可不填）---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
